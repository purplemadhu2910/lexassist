# Copy this file to .env and fill in your values
# Never commit .env to version control

# Required: Get your free API key from https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Optional: Override the default LLM model
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: Set your deployed frontend URL for CORS (comma-separated if multiple)
# FRONTEND_URL=https://your-frontend.onrender.com

# Optional: Max characters to send from uploaded documents to the LLM
# MAX_DOC_CHARS=4000
